<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>
        Wanted: <%= criminal.name %>
        <img src="<%= criminal.profile %>" alt="<%= criminal.name %>">
    </h1>
    <ul>
        <% for (const h of criminal.hobbies) { %>
            <li><%= h %></li>
        <% } %>
    </ul>
</body>
</html>